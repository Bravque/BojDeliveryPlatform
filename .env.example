# Copy to .env and adjust. NEVER commit a real .env or any real secrets / personal data.
# Phase 0 only validates the variables that are actually used today; the rest are
# reserved placeholders for later phases and are documented here for visibility.

# --- Core (used in Phase 0) ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# MySQL connection string. Matches the docker-compose service credentials below.
DATABASE_URL=mysql://boj:boj_local_pw@127.0.0.1:3306/boj_dev

# --- Auth (used in Phase 1; required to run the API server, not for db:migrate) ---
# RS256 key pair for access tokens. Generate locally; NEVER commit real keys:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt_private.pem
#   openssl rsa -pubout -in jwt_private.pem -out jwt_public.pem
# Paste each PEM as a single line using \n for newlines (expanded on load), e.g.
#   JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=boj-api
JWT_AUDIENCE=boj-clients
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
# OTP: codes are hashed with OTP_PEPPER (min 16 chars). Set a long random value.
OTP_PEPPER=change-me-to-a-long-random-string
OTP_LENGTH=6
OTP_TTL_SEC=300
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_WINDOW_SEC=3600
OTP_MAX_PER_PHONE=5
OTP_MAX_PER_IP=20
# Dashboard email/password login: account lockout after N failures for a backoff window.
PASSWORD_MAX_ATTEMPTS=5
PASSWORD_LOCKOUT_SEC=900
SMS_PROVIDER=mock                       # mock (only option in Phase 1)

# --- Payments (used from Phase 4) ---
PAYMENT_PROVIDER=simulated              # simulated | daraja_sandbox | daraja_prod
# Shared secret the M-Pesa STK callback must present as X-Webhook-Token. When unset the webhook
# rejects all calls; drive payments locally via the admin dev-simulate endpoint instead.
# MPESA_WEBHOOK_TOKEN=change-me-to-a-long-random-string

# --- Daraja / M-Pesa STK (required when PAYMENT_PROVIDER=daraja_sandbox|daraja_prod; Phase 8) ---
# DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
# DARAJA_CONSUMER_KEY=
# DARAJA_CONSUMER_SECRET=
# DARAJA_SHORTCODE=174379
# DARAJA_PASSKEY=
# DARAJA_CALLBACK_URL=https://api.your-domain.co.ke/api/v1/webhooks/mpesa/stk
# Optional: comma-separated source IPs allowed to call the callback webhook (empty = no IP check).
# DARAJA_WEBHOOK_IP_ALLOWLIST=

# --- HTTP hardening (used from Phase 8) ---
# CORS allow-list: comma-separated origins permitted to call the API from a browser. Empty = none
# (same-origin only). e.g. https://merchant.boj.co.ke,https://admin.boj.co.ke
CORS_ALLOWED_ORIGINS=
# Number of trusted proxy hops in front of the API (for correct client IPs behind a load balancer).
TRUST_PROXY=1
# Per-IP rate limiting: window length + global request cap, plus a stricter cap on /api/v1/auth.
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# --- Reserved for later phases (NOT read yet) ---
# REDIS_URL=redis://127.0.0.1:6379
# GOOGLE_MAPS_API_KEY=
# OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
