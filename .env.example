# Copy to .env and adjust. NEVER commit a real .env or any real secrets / personal data.
# Phase 0 only validates the variables that are actually used today; the rest are
# reserved placeholders for later phases and are documented here for visibility.

# --- Core (used in Phase 0) ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# MySQL connection string. Matches the docker-compose service credentials below.
DATABASE_URL=mysql://boj:boj_local_pw@127.0.0.1:3306/boj_dev

